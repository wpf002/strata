{
  "name": "strata",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently --names \"API,WEB\" --prefix-colors \"cyan,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "backend/.venv/bin/uvicorn backend.main:app --reload --port ${STRATA_API_PORT:-8080}",
    "dev:web": "cd web && npm run dev",
    "install:all": "cd web && npm install",
    "type-check": "cd web && npx tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "jsdom": "^29.0.2",
    "vitest": "^4.1.4"
  }
}

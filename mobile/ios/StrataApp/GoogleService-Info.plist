<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PLACEHOLDER — Replace with your real Firebase iOS config.

  Instructions:
  1. Go to console.firebase.google.com
  2. Create or open your STRATA project
  3. Add an iOS app with bundle ID 'com.strata.mobile'
  4. Download GoogleService-Info.plist and replace this file
  5. Move the file to ios/GoogleService-Info.plist after native directories are generated
  6. Set FIREBASE_SERVER_KEY in backend/.env from Project Settings > Cloud Messaging
-->
<plist version="1.0">
<dict>
  <key>CLIENT_ID</key>
  <string>REPLACE_WITH_YOUR_CLIENT_ID</string>
  <key>REVERSED_CLIENT_ID</key>
  <string>REPLACE_WITH_YOUR_REVERSED_CLIENT_ID</string>
  <key>API_KEY</key>
  <string>REPLACE_WITH_YOUR_API_KEY</string>
  <key>GCM_SENDER_ID</key>
  <string>000000000000</string>
  <key>PLIST_VERSION</key>
  <string>1</string>
  <key>BUNDLE_ID</key>
  <string>com.strata.mobile</string>
  <key>PROJECT_ID</key>
  <string>strata-mobile</string>
  <key>STORAGE_BUCKET</key>
  <string>strata-mobile.appspot.com</string>
  <key>IS_ADS_ENABLED</key>
  <false/>
  <key>IS_ANALYTICS_ENABLED</key>
  <false/>
  <key>IS_APPINVITE_ENABLED</key>
  <true/>
  <key>IS_GCM_ENABLED</key>
  <true/>
  <key>IS_SIGNIN_ENABLED</key>
  <true/>
  <key>GOOGLE_APP_ID</key>
  <string>1:000000000000:ios:0000000000000000</string>
</dict>
</plist>

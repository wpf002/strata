# STRATA Mobile — environment config
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Inlined at build time by react-native-dotenv (see babel.config.js), so after
# editing: restart Metro with `--reset-cache` and rebuild. A reload won't do it.

SUPABASE_URL=https://mawabokdbrmzegjtvzyz.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# The dev backend. Match whatever STRATA_API_PORT the API is running on.
# iOS simulator reaches the host directly; for Android the `adb reverse` in
# SETUP.md §4 makes localhost work there too.
API_BASE_URL=http://localhost:8083

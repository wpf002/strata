# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/strata

# Supabase project URL and JWT secret (Settings > API in Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ATTOM Data API (property data, comps, tax records)
ATTOM_API_KEY=

# RentCast API (rent estimates)
RENTCAST_API_KEY=

# SendGrid (email alerts for saved searches)
SENDGRID_API_KEY=

# App settings
ENVIRONMENT=development
DEBUG=false

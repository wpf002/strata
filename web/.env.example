# Copy to .env.local and fill in. Leave VITE_API_URL empty in dev — Vite proxies
# API paths to the backend on :8080 (see vite.config.ts).
VITE_API_URL=

# true  → run the UI off src/data/mockData.ts, no backend needed
# false → talk to the FastAPI backend
VITE_USE_MOCK=false

# Supabase → Project Settings → API. The anon key is publishable; RLS enforces access.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

#!/usr/bin/env bash
# Launch strata dev servers (API + web) fully detached so they survive
# whatever subprocess management hangs them when started inline.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOG_DIR="$ROOT/.dev-logs"
PID_DIR="$ROOT/.dev-logs"
mkdir -p "$LOG_DIR"

API_LOG="$LOG_DIR/api.log"
WEB_LOG="$LOG_DIR/web.log"
API_PID="$PID_DIR/api.pid"
WEB_PID="$PID_DIR/web.pid"

is_running() {
  local pidfile="$1"
  [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null
}

preflight() {
  # Fail fast before launching anything if the Docker dependencies the app
  # actually needs are down. Otherwise uvicorn comes up "green" but every
  # request that touches Postgres / Redis / Meilisearch 500s and the UI
  # white-screens — exactly the failure mode we want to prevent.
  local required=(bt-postgres bt-redis bt-meilisearch)

  if ! docker info >/dev/null 2>&1; then
    if [[ -d "/Applications/Docker.app" ]]; then
      echo "Docker Desktop isn't running — starting it..."
      open -a Docker
      local deadline=$((SECONDS + 90))
      while (( SECONDS < deadline )); do
        if docker info >/dev/null 2>&1; then echo "  Docker ready"; break; fi
        sleep 2
      done
    fi
    if ! docker info >/dev/null 2>&1; then
      echo "Docker Desktop did not start within 90s. Start it manually and retry." >&2
      echo "(Required containers: ${required[*]})" >&2
      return 1
    fi
  fi

  local stopped=() missing=()
  for c in "${required[@]}"; do
    local status
    status=$(docker inspect -f '{{.State.Status}}' "$c" 2>/dev/null || echo "missing")
    case "$status" in
      running) : ;;
      missing) missing+=("$c") ;;
      *)       stopped+=("$c") ;;
    esac
  done

  if (( ${#missing[@]} > 0 )); then
    echo "Required container(s) don't exist: ${missing[*]}" >&2
    echo "These are usually created by docker compose in a sibling project." >&2
    return 1
  fi

  if (( ${#stopped[@]} > 0 )); then
    echo "Starting stopped container(s): ${stopped[*]}"
    docker start "${stopped[@]}" >/dev/null || { echo "  failed to start containers" >&2; return 1; }
    # Wait for postgres to actually accept connections (5s is plenty for warm start).
    local deadline=$((SECONDS + 15))
    while (( SECONDS < deadline )); do
      if docker exec bt-postgres pg_isready -U postgres >/dev/null 2>&1; then break; fi
      sleep 1
    done
  fi
}

start() {
  # Launch inline (no Terminal.app). When started from a Claude Code Bash tool,
  # spawned children inherit a background QoS policy that throttles them to
  # near-zero CPU — uvicorn never finishes importing. After spawning, we call
  # `taskpolicy -B -t 0` on each PID to cancel the background policy. This is
  # a no-op (just harmless errors) when started from a regular interactive
  # shell where no throttling is in effect.
  preflight || return 1
  : > "$API_LOG"
  : > "$WEB_LOG"
  rm -f "$API_PID" "$WEB_PID"

  ( cd "$ROOT" && nohup "$ROOT/backend/.venv/bin/uvicorn" backend.main:app \
      --host 127.0.0.1 --port 8080 >> "$API_LOG" 2>&1 < /dev/null &
    echo $! > "$API_PID" )
  ( cd "$ROOT/web" && nohup npm run dev >> "$WEB_LOG" 2>&1 < /dev/null &
    echo $! > "$WEB_PID" )

  if command -v taskpolicy >/dev/null 2>&1; then
    taskpolicy -B -t 0 -p "$(cat "$API_PID")" 2>/dev/null || true
    taskpolicy -B -t 0 -p "$(cat "$WEB_PID")" 2>/dev/null || true
  fi

  echo "Launched API (pid $(cat "$API_PID")) + Web (pid $(cat "$WEB_PID")) inline. Waiting for readiness..."

  wait_http() {
    # Poll an HTTP endpoint until it returns 2xx/3xx. Fails after timeout
    # and tails the log so we don't silently mislead the caller.
    local label="$1" url="$2" log="$3" deadline=$((SECONDS + 300))
    while (( SECONDS < deadline )); do
      local code
      code=$(curl -sS -m 2 -o /dev/null -w "%{http_code}" "$url" 2>/dev/null || echo 000)
      if [[ "$code" =~ ^[23] ]]; then
        echo "  $label ready: $url ($code)"
        return 0
      fi
      printf '.'
      sleep 2
    done
    echo
    echo "  $label FAILED to come up at $url within $((deadline - SECONDS + 300))s. Last log lines:" >&2
    tail -n 30 "$log" >&2
    return 1
  }

  local ok=0
  # /health proves uvicorn is alive. /markets/supported proves the DB session
  # works and at least one router is wired correctly — the difference between
  # "started" and "actually usable".
  wait_http "API"     "http://127.0.0.1:8080/health"            "$API_LOG" || ok=1
  wait_http "API+DB"  "http://127.0.0.1:8080/markets/supported" "$API_LOG" || ok=1
  wait_http "Web"     "http://127.0.0.1:5174/"                  "$WEB_LOG" || ok=1
  if (( ok != 0 )); then
    echo "One or more services did not become ready. See logs above." >&2
    exit 1
  fi
  echo "  API:  http://localhost:8080  (log: $API_LOG)"
  echo "  Web:  http://localhost:5174  (log: $WEB_LOG)"
}

stop() {
  for f in "$API_PID" "$WEB_PID"; do
    [[ -f "$f" ]] || continue
    pid=$(cat "$f")
    if kill -0 "$pid" 2>/dev/null; then
      pkill -TERM -P "$pid" 2>/dev/null || true
      kill -TERM "$pid" 2>/dev/null || true
      echo "Stopped pid $pid"
    fi
    rm -f "$f"
  done
}

status() {
  for label in API Web; do
    if [[ "$label" == API ]]; then pidfile=$API_PID; port=8080; else pidfile=$WEB_PID; port=""; fi
    if is_running "$pidfile"; then
      echo "$label: running (pid $(cat "$pidfile"))${port:+ on :$port}"
    else
      echo "$label: stopped"
    fi
  done
}

logs() {
  case "${1:-both}" in
    api) tail -n 50 -f "$API_LOG" ;;
    web) tail -n 50 -f "$WEB_LOG" ;;
    *)   tail -n 25 "$API_LOG" "$WEB_LOG" ;;
  esac
}

case "${1:-start}" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 1; start ;;
  status) status ;;
  logs) shift; logs "${1:-}" ;;
  *) echo "usage: $0 {start|stop|restart|status|logs [api|web]}"; exit 1 ;;
esac
